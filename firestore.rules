rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /trips/{tripId} {
      allow read: if resource.data.isPublic == true || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /itinerary/{itemId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid);
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }
      
      match /expenses/{expenseId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid);
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }

      match /attachments/{attachmentId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid);
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }

      match /outfits/{outfitId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid);
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }

      match /packingItems/{itemId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.isPublic == true || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid);
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }
    }
  }
}
